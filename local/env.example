# Market Agent secrets — copied to ~/market-agent/.env by local/setup_mac.sh (chmod 600).
# Use FRESH values. Never commit or share this file.

# Anthropic console → API keys. Set a monthly spend cap on the key.
ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather for the token; get your chat id by
# messaging the bot, then opening https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
